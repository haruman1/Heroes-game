--- !u!114 &217299869
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 217299868}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc4dce884f1edc346ae099bc28fca5ff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OpeningStoryController
  dialogAwalOpening:
  - speakerName: 
    dialogueText: Setiap orang memiliki perjalanan hidupnya masing-masing. Tidak
      semua perjalanan berjalan dengan mudah. Namun selalu ada kesempatan untuk terus
      melangkah.
    voiceAudio: {fileID: 0}
    isRightSide: 0
  - speakerName: 
    dialogueText: "Sejak mengetahui kondisiku\u2026 Aku masih berusaha menjalani
      hidup seperti biasa... Tapi kadang, aku masih bingung mulai dari mana. Aku
      ingin belajar menerima ini mengenai bagaimana menjaga diriku."
    voiceAudio: {fileID: 0}
    isRightSide: 0
  - speakerName: 
    dialogueText: Halo permisi, apa ada orang di dalam?
    voiceAudio: {fileID: 0}
    isRightSide: 0
  - speakerName: Penjaga Perpustakaan
    dialogueText: Halo, selamat datang.
    voiceAudio: {fileID: 0}
    isRightSide: 1
  - speakerName: 
    dialogueText: Aku dengar tempat ini menyimpan banyak pengetahuan.
    voiceAudio: {fileID: 0}
    isRightSide: 0
  - speakerName: Penjaga Perpustakaan
    dialogueText: Yaa itu dulu.. (tersenyum sedih)
    voiceAudio: {fileID: 0}
    isRightSide: 1
  - speakerName: 
    dialogueText: Dulu? Lalu bagaimana dengan sekarang?
    voiceAudio: {fileID: 0}
    isRightSide: 0
  - speakerName: Penjaga Perpustakaan
    dialogueText: Sudah kosong.
    voiceAudio: {fileID: 0}
    isRightSide: 1
  - speakerName: 
    dialogueText: Kemana semua isi buku itu?
    voiceAudio: {fileID: 0}
    isRightSide: 0
  - speakerName: Penjaga Perpustakaan
    dialogueText: Hilang.. sejak makhluk itu mencuri semua halaman-halaman buku ini
      dan sekarang tinggal tersisa sampulnya. Padahal buku ini membantu banyak orang
      untuk memahami cara menjaga kualitas hidupnya.
    voiceAudio: {fileID: 0}
    isRightSide: 1
  - speakerName: 
    dialogueText: Karna dicuri makhluk itu isi pengetahuannya juga hilang?
    voiceAudio: {fileID: 0}
    isRightSide: 0
  - speakerName: Penjaga Perpustakaan
    dialogueText: Iyaa..
    voiceAudio: {fileID: 0}
    isRightSide: 1
  - speakerName: 
    dialogueText: Kalau aku menemukan halaman-halaman yang hilang itu, apakah bukunya
      kembali utuh dan aku bisa ikut membaca dan mempelajarinya?
    voiceAudio: {fileID: 0}
    isRightSide: 0
  - speakerName: Penjaga Perpustakaan
    dialogueText: Yaa tentu, namun tidak semua halaman akan datang sekaligus, halaman
      itu ditemukan sedikit demi sedikit.
    voiceAudio: {fileID: 0}
    isRightSide: 1
  choicePanelUI: {fileID: 1519970232}
  choicePromptText: {fileID: 1604321649}
  buttonYa: {fileID: 2120741756}
  buttonTidak: {fileID: 896843924}
  dialogPilihTidak:
  - speakerName: 
    dialogueText: Aku belum yakin.
    voiceAudio: {fileID: 8300000, guid: 7b927fb2e9611954f8dc3f2e13f72888, type: 3}
    isRightSide: 0
  - speakerName: Penjaga Perpustakaan
    dialogueText: Tidak apa-apa, semua perjalanan dimulai saat seseorang siap melangkah.
    voiceAudio: {fileID: 8300000, guid: 0e3b332ae9032024e8102eaea55f375e, type: 3}
    isRightSide: 1
  dialogPilihYa:
  - speakerName: Penjaga Perpustakaan
    dialogueText: Setiap halaman yang kamu temukan, akan tersimpan di sini, gunakan
      ini (item) jika di perjalanan terasa berat.
    voiceAudio: {fileID: 8300000, guid: 9f4b1f78703704841bab1be7f91783cd, type: 3}
    isRightSide: 1
  namaScenePetaPerjalanan: Pilih Maps
  namaSceneLevelPertama: LEVEL 1
  jumlahBoosterAwal: 3
