  m_Script: {fileID: 11500000, guid: 2376673bfd40a02409a4ea8559cde61d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InitialDialogueManager
  dialoguePanel: {fileID: 1620915698}
  characterNameText: {fileID: 1871190646}
  dialogueText: {fileID: 2022099914}
  nextDialogueButton: {fileID: 274491634}
  playerPortraitPosition: {fileID: 1467515988}
  npcPortraitPosition: {fileID: 59547182}
  malePlayerSprite: {fileID: 7231989508707924950, guid: 79e0f573318d5774d8750ececfd3025a, type: 3}
  femalePlayerSprite: {fileID: -4976450733685547303, guid: d9393499015517a42ada56c1cb2b13b0, type: 3}
  typeSpeed: 0.03
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
  dialogues:
  - speakerName: '{name}'
    npcSprite: {fileID: 0}
    dialogueText: Dok,,jujur badan saya rasanya lemas sekali hari ini. Seperti ... 
      kehilangan tenaga untuk sekedar berdiri lama. apakah gegara usia {usia} saya
      ?
  - speakerName: Soni
    npcSprite: {fileID: 5277578028792060664, guid: 382be8991d49a9a49b6ef079fdc5f396, type: 3}
    dialogueText: "Saya paham, {name}. Kabar ini pasti berar untuk di proses \r\nsekarang.
      Tapi perlu diingat, rasa lemas yang kamu rasakan saat ini murni \r\nkarena
      pikiranmu sedang kelelahan, bukan karena fisikmu rusak."
  - speakerName: '{name}'
    npcSprite: {fileID: 0}
    dialogueText: '"Jadi, fisik saya sebenarnya tidak apa-apa, Dok?'
  - speakerName: Soni
    npcSprite: {fileID: 5277578028792060664, guid: 382be8991d49a9a49b6ef079fdc5f396, type: 3}
    dialogueText: "Betul. Secara biologis, tubuhmu masih sekuat kemarin. Di perpustakaan
      \r\ndepan ada catatan medis soal ini. Coba kamu baca agar hatimu lebih tenang."
  maleDialogue18_24: 
  maleDialogue25_34: Dok,,jujur badan saya rasanya lemas sekali hari ini. Seperti
    ...  kehilangan tenaga untuk sekedar berdiri lama
  maleDialogue35_44: Dok,,jujur badan saya rasanya lemas sekali hari ini. Seperti
    ...  kehilangan tenaga untuk sekedar berdiri lama
